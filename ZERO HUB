local function getMyHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function getClosestEnemy(isBossMode, maxDist)
    local hrp = getMyHRP()
    if not hrp then return nil end
    
    local myLevel = Level.Value
    local closestEnemy = nil
    local shortestDistance = maxDist or 1000
    
    -- Verificar que existe la carpeta de enemigos
    if not workspace:FindFirstChild("Enemies") then return nil end
    
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        local Humanoid = v:FindFirstChild("Humanoid")
        local RootPart = v:FindFirstChild("HumanoidRootPart")
        if Humanoid and RootPart and Humanoid.Health > 0 then
            local distance = (hrp.Position - RootPart.Position).Magnitude
            if distance < shortestDistance then
                local name = v.Name
                local hasBoss = string.find(name:lower(), "boss")
                
                if isBossMode then
                    if hasBoss then
                        closestEnemy = v
                        shortestDistance = distance
                    end
                else
                    if not hasBoss then
                        local enemyLvl = tonumber(name:match("%d+")) or 0
                        if enemyLvl >= myLevel - 150 and enemyLvl <= myLevel + 50 then
                            closestEnemy = v
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
    end
    return closestEnemy
end

local function startFarmConnection()
    if farmConnection then return end
    
    farmConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = player.Character
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return end
            
            local hrp = getMyHRP()
            if not hrp then return end
            
            -- Auto Farm Nivel (mobs normales)
            if autoFarmLevelEnabled then
                local enemy = getClosestEnemy(false, 1200)
                if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 then
                        local ehrp = enemy.HumanoidRootPart
                        local targetCF = ehrp.CFrame * CFrame.new(math.random(-5,5)*0.1, 0, math.random(-5,5)*0.1)
                        hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.35)
                        VirtualUser:ClickButton1(Vector2.new())
                    end
                end
            end
            
            -- Auto Farm Boss
            if autoFarmBossEnabled then
                local enemy = getClosestEnemy(true, 2500)
                if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") then
                    if enemy.Humanoid.Health > 0 then
                        local ehrp = enemy.HumanoidRootPart
                        local targetCF = ehrp.CFrame * CFrame.new(math.random(-8,8)*0.1, math.random(3,8), math.random(-12,-6))
                        hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.45)
                        VirtualUser:ClickButton1(Vector2.new())
                    end
                end
            end
        end)
    end)
end

local function stopFarmConnection()
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
end

local function updateFarmConnection()
    if autoFarmLevelEnabled or autoFarmBossEnabled then
        startFarmConnection()
    else
        stopFarmConnection()
    end
end

