local function createToggleButton(name, toggleFunc, description)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, -20, 0, 55)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 70)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = name .. " [OFF]"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextScaled = true
    btn.LayoutOrder = 1
    btn.Parent = TabContainer
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 12)
    btnCorner.Parent = btn
    
    local btnGradient = Instance.new("UIGradient")
    btnGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60,60,90)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(35,35,55))
    }
    btnGradient.Rotation = 45
    btnGradient.Parent = btn
    
    -- Tooltips
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55,55,80)}):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        local isOn = btn.Text:find("[ON]")
        local offColor = isOn and Color3.fromRGB(40, 200, 40) or Color3.fromRGB(45,45,70)
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = offColor}):Play()
    end)
    
    btn.MouseButton1Click:Connect(toggleFunc)
    
    return btn
end

local function createLabel(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 30)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(180, 180, 220)
    label.TextScaled = true
    label.LayoutOrder = 0
    label.Parent = TabContainer
    return label
end

