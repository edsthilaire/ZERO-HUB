local function createESP(obj, espType, color)
    pcall(function()
        if not obj or not obj:FindFirstChild("HumanoidRootPart") then return end
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_" .. espType
        billboard.Adornee = obj.HumanoidRootPart
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = obj.HumanoidRootPart
        
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = color
        frame.BackgroundTransparency = 0.5
        frame.BorderSizePixel = 0
        frame.Parent = billboard
        
        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = espType .. "\n" .. obj.Name
        text.TextColor3 = Color3.new(1,1,1)
        text.TextScaled = true
        text.Font = Enum.Font.GothamBold
        text.Parent = frame
        
        table.insert(espObjects, billboard)
    end)
end

local function startESP()
    if espConnection then return end
    
    espConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            if not espEnabled then return end
            
            -- Limpiar ESP antiguo
            for i, obj in pairs(espObjects) do
                if obj and obj.Parent then
                    obj:Destroy()
                end
            end
            espObjects = {}
            
            -- ESP de Enemigos
            if workspace:FindFirstChild("Enemies") then
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    local eHum = enemy:FindFirstChild("Humanoid")
                    local eHRP = enemy:FindFirstChild("HumanoidRootPart")
                    if eHum and eHRP and eHum.Health > 0 then
                        createESP(enemy, "ENEMY", Color3.fromRGB(255, 50, 50))
                    end
                end
            end
            
            -- ESP de Jugadores
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        createESP(plr.Character, "PLAYER", Color3.fromRGB(50, 255, 50))
                    end
                end
            end
            
            task.wait(1)
        end)
    end)
end

local function stopESP()
    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
    
    for i, obj in pairs(espObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    espObjects = {}
end

