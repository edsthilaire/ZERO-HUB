--// Función para agregar logs
local function AddLog(message, color)
    if not Settings.ShowLogs then return end
    local log = Instance.new("TextLabel")
    log.Parent = ScrollLogs
    log.Size = UDim2.new(1, -5, 0, 18)
    log.BackgroundTransparency = 1
    log.Text = message
    log.Font = Enum.Font.Gotham
    log.TextSize = 11
    log.TextColor3 = color or Color3.fromRGB(200, 200, 200)
    log.TextXAlignment = Enum.TextXAlignment.Left
    log.TextWrapped = true
    
    ScrollLogs.CanvasSize = UDim2.new(0, 0, 0, LogsLayout.AbsoluteContentSize.Y + 10)
    -- Auto-scroll al final
    task.wait(0.05)
    ScrollLogs.CanvasPosition = Vector2.new(0, ScrollLogs.CanvasSize.Y.Offset)
end

--// Función para formatear tiempo
local function formatTime(seconds)
    local days = math.floor(seconds / 86400)
    seconds = seconds % 86400
    local hours = math.floor(seconds / 3600)
    seconds = seconds % 3600
    local minutes = math.floor(seconds / 60)
    local secs = seconds % 60
    local parts = {}
    if days > 0 then table.insert(parts, days.."d") end
    if hours > 0 then table.insert(parts, hours.."h") end
    if minutes > 0 then table.insert(parts, minutes.."m") end
    table.insert(parts, secs.."s")
    return table.concat(parts, " ")
end

--// Función para simular movimiento (WASD o ratón)
local function SimulateMovement()
    if not isRunning or not Settings.SimulateMovement then return end
    if Settings.MovementType == "WASD" then
        -- Simular presionar tecla W por un momento
        local key = Enum.KeyCode.W
        game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
        task.wait(0.2)
        game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
        AddLog("🦶 Movimiento simulado (W)", Color3.fromRGB(100, 200, 255))
    else
        -- Simular movimiento del ratón
        local mouse = LocalPlayer:GetMouse()
        local originalPos = mouse.X
        local newPos = originalPos + 50
        game:GetService("VirtualInputManager"):SendMouseMovementEvent(newPos, mouse.Y, 0)
        task.wait(0.1)
        game:GetService("VirtualInputManager"):SendMouseMovementEvent(originalPos, mouse.Y, 0)
        AddLog("🖱️ Ratón simulado", Color3.fromRGB(100, 200, 255))
    end
end

--// Anti-Kick usando VirtualUser o fallback
local function AntiKick()
    if not isRunning or not Settings.AntiAFK then return end
    local success, err = pcall(function()
        if Settings.UseVirtualUser then
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        else
            -- Fallback: simular tecla sin movimiento
            game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
            task.wait(0.05)
            game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        end
    end)
    if success then
        AddLog("🛡️ Kick evadido a los " .. formatTime(afkTime), Color3.fromRGB(255, 150, 100))
    else
        AddLog("⚠️ Error al evadir kick: " .. tostring(err), Color3.fromRGB(255, 80, 80))
    end
end

--// Evento Idled
local function setupIdled()
    LocalPlayer.Idled:Connect(function()
        if isRunning and Settings.AntiAFK then
            AntiKick()
        end
    end)
end
setupIdled()

--// Timer y movimiento periódico
task.spawn(function()
    while true do
        task.wait(1)
        if isRunning then
            afkTime = afkTime + 1
            TimerText.Text = "⏱️ Tiempo AFK: " .. formatTime(afkTime)
            
            -- Movimiento automático cada X segundos
            if Settings.SimulateMovement then
                movementTimer = movementTimer + 1
                if movementTimer >= Settings.MovementInterval then
                    movementTimer = 0
                    SimulateMovement()
                end
            end
        end
    end
end)

