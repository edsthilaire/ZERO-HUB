--// FUNCIONES DE AUTO STATS
--// ============================================================

local function autoStats()
    pcall(function()
        local points = Data.Points
        if points and points.Value > 0 then
            -- Distribuir puntos equilibradamente
            local melee = Data.Melee
            local defense = Data.Defense
            local sword = Data.Sword
            local gun = Data.Gun
            local fruit = Data.Fruit
            
            if melee then melee.Value = melee.Value + 1 end
            task.wait(0.1)
            if defense then defense.Value = defense.Value + 1 end
            task.wait(0.1)
            if sword then sword.Value = sword.Value + 1 end
            task.wait(0.1)
            if gun then gun.Value = gun.Value + 1 end
            task.wait(0.1)
            if fruit then fruit.Value = fruit.Value + 1 end
        end
    end)
end

