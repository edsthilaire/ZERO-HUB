--// Servicios
local Players        = game:GetService("Players")
local TweenService   = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--// Crear ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BloxFruitsCoolMenu"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = playerGui

--// Frame principal del menú
local MainFrame = Instance.new("Frame")
MainFrame.Name = "Main"
MainFrame.Size = UDim2.fromScale(0.38, 0.62)
MainFrame.Position = UDim2.fromScale(0.31, 1.2)   -- empieza escondido abajo
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
MainFrame.BorderSizePixel = 0
MainFrame.ClipsDescendants = true
MainFrame.Visible = false
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 14)
UICorner.Parent = MainFrame

local UIGradient = Instance.new("UIGradient")
UIGradient.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(35,35,55)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(15,15,25))
}
UIGradient.Rotation = 90
UIGradient.Parent = MainFrame

--// Título
