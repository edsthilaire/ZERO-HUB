local function getMyHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

function getClosestEnemy(isBossMode, maxDist, questMon)
    local hrp = getMyHRP()
    if not hrp then return nil end

    local myLevel = Level.Value
    local closest, minDist = nil, maxDist or 1400

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    for _, enemy in pairs(enemiesFolder:GetChildren()) do
        local hum = enemy:FindFirstChildWhichIsA("Humanoid")
        local root = enemy:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0.1 then
            local dist = (hrp.Position - root.Position).Magnitude
            if dist > minDist then continue end

            local nameLower = enemy.Name:lower()
            local isBoss = nameLower:find("boss") or nameLower:find("[boss]") or nameLower:find("king") or nameLower:find("lord")

            local match = true
            if questMon then
                match = string.find(enemy.Name, questMon)
            elseif not isBossMode then
                local lvlStr = enemy.Name:match("%d+")
                local eLvl = lvlStr and tonumber(lvlStr) or 0
                match = (eLvl >= myLevel - 180 and eLvl <= myLevel + 80)
            else
                match = isBoss
            end

            if match then
                closest, minDist = enemy, dist
            end
        end
    end
    return closest
end

local function tryAttack()
    local char = player.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    else
        VirtualUser:ClickButton1(Vector2.new())
    end
end

local function startFarmConnection()
    if farmConnection then return end

    farmConnection = RunService.Heartbeat:Connect(function(delta)
        pcall(function()
            local char = player.Character
            if not char or char.Humanoid.Health <= 0 then return end
            local hrp = getMyHRP()
            if not hrp then return end

            local attacked = false

            -- PRIORIDAD: AUTO QUEST
            if autoQuestEnabled then
                local quest, num, questMon, questCF = getQuestData(Level.Value)
                if quest then
                    -- Buscar enemigo de quest
                    local enemy = getClosestEnemy(false, 1500, questMon)
                    if enemy then
                        local eRoot = enemy.HumanoidRootPart
                        local dist = (hrp.Position - eRoot.Position).Magnitude
                        local offset = CFrame.new(math.random(-8,8)*0.2, 5, math.random(-8,8)*0.2)
                        local targetCF = eRoot.CFrame * offset
                        hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.2 + delta*2)
                        if dist < 40 then
                            tryAttack()
                            attacked = true
                        end
                    else
                        -- No hay enemigo de quest cerca → ir por quest
                        if tick() - lastQuestAttempt > 25 then
                            hrp.CFrame = questCF * CFrame.new(0, 10, 0)
                            task.wait(0.6)
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest, num)
                            task.wait(0.8)
                            lastQuestAttempt = tick()
                        end
                    end
                end
            -- NORMAL FARM NIVEL
            elseif autoFarmLevelEnabled then
                local enemy = getClosestEnemy(false, 1300)
                if enemy then
                    local eRoot = enemy.HumanoidRootPart
                    local dist = (hrp.Position - eRoot.Position).Magnitude
                    local offset = CFrame.new(math.random(-6,6)*0.3, 4, math.random(-6,6)*0.3)
                    local targetCF = eRoot.CFrame * offset
                    hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.18 + delta*2)
                    if dist < 35 then
                        tryAttack()
                        attacked = true
                    end
                end
            -- FARM BOSS
            elseif autoFarmBossEnabled then
                local enemy = getClosestEnemy(true, 3000)
                if enemy then
                    local eRoot = enemy.HumanoidRootPart
                    local dist = (hrp.Position - eRoot.Position).Magnitude
                    local offset = CFrame.new(math.random(-12,12)*0.2, 6, math.random(-15,-5))
                    local targetCF = eRoot.CFrame * offset
                    hrp.CFrame = hrp.CFrame:Lerp(targetCF, 0.25 + delta*2.5)
                    if dist < 50 then
                        tryAttack()
                        attacked = true
                    end
                end
            end

            -- Anti-stuck
            if not attacked and (autoQuestEnabled or autoFarmLevelEnabled or autoFarmBossEnabled) and hrp.Velocity.Magnitude < 10 then
                hrp.CFrame = hrp.CFrame * CFrame.new(0, 12, 0)
            end
        end)
    end)
end

