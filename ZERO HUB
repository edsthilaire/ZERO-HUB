-- Funciones auxiliares
local function AddLog(msg, color)
    if not Settings.ShowLogs then return end
    local log = Instance.new("TextLabel")
    log.Parent = Scroll
    log.Size = UDim2.new(1, -5, 0, 18)
    log.BackgroundTransparency = 1
    log.Text = msg
    log.Font = Enum.Font.Gotham
    log.TextSize = 11
    log.TextColor3 = color or Color3.fromRGB(200, 200, 200)
    log.TextXAlignment = Enum.TextXAlignment.Left
    task.wait(0.05)
    Scroll.CanvasPosition = Vector2.new(0, Scroll.CanvasSize.Y.Offset)
end

local function formatTime(sec)
    local m = math.floor(sec / 60)
    local s = sec % 60
    if m > 0 then return m.."m "..s.."s" else return s.."s" end
end

-- Simular movimiento (sin VirtualInputManager, usando solo VirtualUser para clicks)
local function SimulateMovement()
    if not isRunning or not Settings.SimulateMovement then return end
    -- En Delta, VirtualUser suele funcionar para clicks, pero no para teclas
    -- Usamos un método más simple: mover el personaje con BodyVelocity o simplemente un click
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
        AddLog("🦶 Movimiento simulado (click)", Color3.fromRGB(100, 200, 255))
    end)
end

-- Anti-Kick
local function AntiKick()
    if not isRunning or not Settings.AntiAFK then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
        AddLog("🛡️ Kick evadido a los " .. formatTime(afkTime), Color3.fromRGB(255, 150, 100))
    end)
end

-- Evento Idled
LocalPlayer.Idled:Connect(function()
    if isRunning and Settings.AntiAFK then
        AntiKick()
    end
end)

-- Timer
task.spawn(function()
    while true do
        task.wait(1)
        if isRunning then
            afkTime = afkTime + 1
            TimerLabel.Text = "⏱️ Tiempo AFK: " .. formatTime(afkTime)
            movementTimer = movementTimer + 1
            if movementTimer >= Settings.MovementInterval then
                movementTimer = 0
                SimulateMovement()
            end
        end
    end
end)

